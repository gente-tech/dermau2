<main class="du-main">

<section class="du-agreements" data-active="true">
  <div class="du-agreements__container">
    <div class="du-agreements__header center">
      <h2 class="du-agreements__title">
        <span>Convenios</span> Universitarios
      </h2>
      <p class="du-agreements__subtitle">
        Nuestros convenios fortalecen el aprendizaje y aseguran que cada
        programa cumpla con estándares educativos.
      </p>
    </div>

    <div class="swiper swiper-container" id="sw-convenio-agreements">
      <div class="swiper-wrapper">
        {% for convenio in convenios %}
        <div class="swiper-slide du-agreements__slide {% if loop.first %}is-active swiper-slide-active{% endif %}"
             data-target="block-{{ convenio.id }}">
          <img src="{{ convenio.logo }}" alt="{{ convenio.title }}">
        </div>
        {% endfor %}
      </div>

      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

{% for convenio in convenios %}
<section class="du-convenio-block"
         id="block-{{ convenio.id }}"
         {% if not loop.first %}style="display:none"{% endif %}>

  <div class="du-convenio-block__container">

    <div class="du-convenio-block__header">
      <h2 class="du-convenio-block__title">
        {{ convenio.title }}
      </h2>
      <div class="du-convenio-block__info">
        <span> 📍 {{ convenio.ciudad }} </span>
        <span> 🏛️ Fundada en {{ convenio.ano }} </span>
        <span> 📚 {{ convenio.programas|length }} programas</span>
      </div>
      <p class="du-convenio-block__description">
        {{ convenio.descripcion }}
      </p>
    </div>

    <h3 class="du-convenio-block__subtitle">Programas vinculados</h3>
    <div class="du-convenio-block__tags">
      {% for programa in convenio.programas %}
      <div class="du-convenio-block__tag">
        <span class="tag {{ programa.tipo_clase }}">{{ programa.tipo }}</span>
        <span>{{ programa.title }}</span>
      </div>
      {% endfor %}
    </div>

    <h3 class="du-convenio-block__subtitle">Docentes vinculados</h3>

<div class="du-swiper-expert">
  <div class="swiper" id="sw-convenio-experto-{{ convenio.id }}">
    <div class="swiper-wrapper">

      {% for docente in convenio.docentes %}
      <div class="swiper-slide">

        <article class="du-card__expert">

          <div class="du-card__expert-main">

            {% if docente.image %}
            <img src="{{ docente.image }}" class="du-card__expert-img">
            {% endif %}

            <div class="du-card__expert-intro">
              <h3 class="du-card__expert-title">
                {{ docente.title }}
              </h3>

              {% if docente.cargo %}
              <p class="du-card__expert-role">
                {{ docente.cargo }}
              </p>
              {% endif %}
            </div>

          </div>

          <div class="du-card__expert-uni">

            <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2.0432 7.26354V14.6632M1.28453 6.70077C0.746301 6.44295 0.746301 5.74737 1.28453 5.48955C1.99023 5.1515 3.0445 4.67169 4.53573 4.0505C6.60765 3.18746 8.02295 2.67571 8.78278 2.41634C9.21066 2.26975 9.67516 2.26975 10.103 2.41634C10.8625 2.67571 12.2786 3.18746 14.3501 4.0505C15.8417 4.67169 16.8956 5.1515 17.6017 5.48955C18.1391 5.74737 18.1391 6.44295 17.6017 6.70077C16.8956 7.03882 15.8413 7.51863 14.3501 8.13982C12.2782 9.00286 10.8629 9.51461 10.103 9.77399C9.67516 9.92057 9.21066 9.92057 8.78278 9.77399C8.02333 9.51461 6.60726 9.00286 4.53573 8.13982C3.04411 7.51824 1.99023 7.03882 1.28453 6.70077Z" stroke="#007BE3" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M4.41985 8.09106C4.39247 8.61521 4.37923 9.14 4.38013 9.66487C4.38013 10.8699 4.44205 11.6266 4.50281 12.0795C4.55616 12.4752 4.78283 12.8117 5.13646 12.9967C5.82034 13.355 7.20954 13.8843 9.44309 13.8843C11.6766 13.8843 13.0658 13.3554 13.7497 12.9971C14.1033 12.8121 14.33 12.4756 14.3834 12.0803C14.4441 11.627 14.506 10.8702 14.506 9.66565C14.507 9.14065 14.4937 8.61573 14.4663 8.09145M3.21175 15.8316C3.21175 16.1414 3.08865 16.4386 2.86954 16.6577C2.65043 16.8768 2.35325 16.9999 2.04338 16.9999C1.7335 16.9999 1.43632 16.8768 1.21721 16.6577C0.998096 16.4386 0.875 16.1414 0.875 15.8316C0.875 15.5217 0.998096 15.2245 1.21721 15.0054C1.43632 14.7863 1.7335 14.6632 2.04338 14.6632C2.35325 14.6632 2.65043 14.7863 2.86954 15.0054C3.08865 15.2245 3.21175 15.5217 3.21175 15.8316Z" stroke="#007BE3" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>

            <span>{{ docente.universidad }}</span>

          </div>

          <div class="du-card__expert-detail">
            <p>
              {{ docente.descripcion|striptags|length > 180
                ? docente.descripcion|striptags|slice(0, 180) ~ '...'
                : docente.descripcion|striptags
              }}
            </p>
          </div>

          <div class="du-card__expert-footer">
            <a href="#" 
               class="du-link-more du-open-modal"
               data-target="modal-docente-{{ convenio.id }}-{{ loop.index }}">
              Ver detalle
            </a>
          </div>

        </article>

      </div>
      {% endfor %}

    </div>

    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>

  </div>
</div>
{% for docente in convenio.docentes %}
<div id="modal-docente-{{ convenio.id }}-{{ loop.index }}" class="du-modal">
  <div class="du-modal__overlay"></div>

  <div class="du-modal__container">
    <button class="du-modal__close">&times;</button>

    <div class="du-modal__content">

      <aside class="du-modal__aside">

        <img src="{{ docente.image }}" class="du-modal__img">

        <div class="du-modal__personal-info">

          <h3 class="du-modal__name">
            {{ docente.title }}
          </h3>

          <p class="du-modal__role">
            {{ docente.cargo }}
          </p>

          <div class="du-modal__contact">

            {% if docente.ciudad %}
            <div class="du-modal__contact-item">
              <span>{{ docente.ciudad }}</span>
            </div>
            {% endif %}

            {% if docente.email %}
            <div class="du-modal__contact-item">
              <a href="mailto:{{ docente.email }}">
                {{ docente.email }}
              </a>
            </div>
            {% endif %}

            <div class="du-modal__contact-item du-colum">

              <div class="du-modal__contact-redes">

                {% if docente.linkedin %}
                <a href="{{ docente.linkedin }}" target="_blank">
                  LinkedIn
                </a>
                {% endif %}

                {% if docente.facebook %}
                <a href="{{ docente.facebook }}" target="_blank">
                  Facebook
                </a>
                {% endif %}

                {% if docente.instagram %}
                <a href="{{ docente.instagram }}" target="_blank">
                  Instagram
                </a>
                {% endif %}

              </div>

              {% if docente.web %}
              <a href="{{ docente.web }}"
                 class="du-link-external"
                 target="_blank">
                 {{ docente.web }}
              </a>
              {% endif %}

            </div>

          </div>

        </div>

      </aside>

      <main class="du-modal__main">

        <section class="du-modal__section">
          <h4 class="du-modal__section-title">
            Perfil profesional
          </h4>

          <div class="du-modal__bio">
            {{ docente.descripcion|raw }}
          </div>
        </section>

        {% if docente.programas %}
        <section class="du-modal__section">
          <h4 class="du-modal__section-title">
            Programas vinculados
          </h4>

          <div class="du-modal__programs">

            {% for programa in docente.programas %}
            <div class="du-program-tag">
              <span class="tag {{ programa.tipo_clase }}">
                {{ programa.tipo }}
              </span>
              <span class="program-name">
                {{ programa.titulo }}
              </span>
            </div>
            {% endfor %}

          </div>
        </section>
        {% endif %}

      </main>

    </div>

  </div>
</div>
{% endfor %}

  </div>
</section>
{% endfor %}

</main>
<script>
document.addEventListener("DOMContentLoaded", function() {

  /* =========================
     SWIPER TABS
  ========================= */
  const convenioSwiper = new Swiper('#sw-convenio-agreements', {
    slidesPerView: 2,
    spaceBetween: 20,
    navigation: {
      nextEl: '#sw-convenio-agreements .swiper-button-next',
      prevEl: '#sw-convenio-agreements .swiper-button-prev',
    },
    breakpoints: {
      768: { slidesPerView: 3, spaceBetween: 30 },
      1024: { slidesPerView: 4, spaceBetween: 40 }
    }
  });

  const tabs = document.querySelectorAll('#sw-convenio-agreements .swiper-slide');
  const blocks = document.querySelectorAll('.du-convenio-block');

  function activateTab(tab) {
    tabs.forEach(t => {
      t.classList.remove('is-active');
      t.classList.remove('swiper-slide-active');
    });

    tab.classList.add('is-active');
    tab.classList.add('swiper-slide-active');

    const target = tab.dataset.target;

    blocks.forEach(block => {
      block.style.display = 'none';
    });

    const activeBlock = document.getElementById(target);
    if (activeBlock) {
      activeBlock.style.display = 'block';
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      activateTab(this);
    });
  });

  /* =========================
     SWIPER DOCENTES
  ========================= */
  document.querySelectorAll('.du-swiper-expert .swiper').forEach(sw => {
    new Swiper(sw, {
      slidesPerView: 1,
      spaceBetween: 20,
      navigation: {
        nextEl: sw.querySelector('.swiper-button-next'),
        prevEl: sw.querySelector('.swiper-button-prev'),
      },
      pagination: {
        el: sw.querySelector('.swiper-pagination'),
        clickable: true
      },
      breakpoints: {
        1024: {
          slidesPerView: 4,
          spaceBetween: 30
        }
      }
    });
  });

  if (tabs.length) {
    activateTab(tabs[0]);
  }

  /* =========================
     MODAL DOCENTES
  ========================= */
  document.querySelectorAll('.du-open-modal').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();

      const target = this.dataset.target;
      const modal = document.getElementById(target);

      if (modal) {
        modal.classList.add('active');   // <-- IMPORTANTE
        document.body.classList.add('du-modal-open');
      }
    });
  });

  document.querySelectorAll('.du-modal__close, .du-modal__overlay').forEach(btn => {
    btn.addEventListener('click', function() {
      const modal = this.closest('.du-modal');
      if (modal) {
        modal.classList.remove('active');
        document.body.classList.remove('du-modal-open');
      }
    });
  });

  document.addEventListener('keydown', function(e){
    if(e.key === "Escape"){
      document.querySelectorAll('.du-modal.active').forEach(modal=>{
        modal.classList.remove('active');
        document.body.classList.remove('du-modal-open');
      });
    }
  });

});
</script>
