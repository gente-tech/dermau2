<main class="du-main">

<section class="du-agreements" data-active="true">
  <div class="du-agreements__container">
    <div class="du-agreements__header center">
      <h2 class="du-agreements__title">
        <span>Convenios</span> Universitarios
      </h2>
      <p class="du-agreements__subtitle">
        Nuestros convenios fortalecen el aprendizaje y aseguran que cada
        programa cumpla con estándares educativos.
      </p>
    </div>

    <div class="swiper swiper-container" id="sw-convenio-agreements">
      <div class="swiper-wrapper">
        {% for convenio in convenios %}
        <div class="swiper-slide du-agreements__slide {% if loop.first %}is-active{% endif %}"
             data-target="block-{{ convenio.id }}">
            <img src="{{ convenio.logo }}" alt="{{ convenio.title }}">
        </div>
        {% endfor %}
      </div>

      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

{% for convenio in convenios %}
<section class="du-convenio-block"
         id="block-{{ convenio.id }}"
         {% if not loop.first %}style="display:none"{% endif %}>
  <div class="du-convenio-block__container">

    <div class="du-convenio-block__header">
      <h2 class="du-convenio-block__title">
        {{ convenio.title }}
      </h2>
      <div class="du-convenio-block__info">
        <span> 📍 {{ convenio.ciudad }} </span>
        <span> 🏛️ Fundada en {{ convenio.ano }} </span>
        <span> 📚 {{ convenio.programas|length }} programas</span>
      </div>
      <p class="du-convenio-block__description">
        {{ convenio.descripcion }}
      </p>
    </div>

    <h3 class="du-convenio-block__subtitle">Programas vinculados</h3>
    <div class="du-convenio-block__tags">
      {% for programa in convenio.programas %}
      <div class="du-convenio-block__tag">
        <span class="tag tag--diplomado">{{ programa.tipo }}</span>
        <span>{{ programa.title }}</span>
      </div>
      {% endfor %}
    </div>

    <h3 class="du-convenio-block__subtitle">Docentes vinculados</h3>

    <div class="du-swiper-expert">
      <div class="swiper" id="sw-convenio-experto-{{ convenio.id }}">
        <div class="swiper-wrapper">

          {% for docente in convenio.docentes %}
          <div class="swiper-slide">
            <article class="du-card__expert">
              <div class="du-card__expert-main">
                <img src="{{ docente.image }}" class="du-card__expert-img">
                <div class="du-card__expert-intro">
                  <h3 class="du-card__expert-title">{{ docente.title }}</h3>
                  <p class="du-card__expert-role">{{ docente.cargo }}</p>
                </div>
              </div>

              <div class="du-card__expert-uni">
                <span>{{ docente.universidad }}</span>
              </div>

              <div class="du-card__expert-detail">
                <p>{{ docente.descripcion }}</p>
              </div>

              <div class="du-card__expert-footer">
                <a href="{{ docente.url }}" class="du-link-more">Ver detalle</a>
              </div>
            </article>
          </div>
          {% endfor %}

        </div>

        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

  </div>
</section>
{% endfor %}

</main>
<script>
document.addEventListener("DOMContentLoaded", function() {

  /* ================================
     SWIPER LOGOS UNIVERSIDADES
  ==================================*/
  const swConvenios = new Swiper('#sw-convenio-agreements', {
    slidesPerView: 2,
    spaceBetween: 20,
    loop: false,
    navigation: {
      nextEl: '#sw-convenio-agreements .swiper-button-next',
      prevEl: '#sw-convenio-agreements .swiper-button-prev',
    },
    breakpoints: {
      768: {
        slidesPerView: 3,
        spaceBetween: 30
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 40
      }
    }
  });


  /* ================================
     TABS CONVENIOS
  ==================================*/
  const tabs = document.querySelectorAll('.du-agreements__slide');
  const blocks = document.querySelectorAll('.du-convenio-block');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {

      tabs.forEach(t => t.classList.remove('is-active'));
      this.classList.add('is-active');

      const target = this.dataset.target;

      blocks.forEach(block => block.style.display = "none");

      const active = document.getElementById(target);
      if (active) active.style.display = "block";

    });
  });


  /* ================================
     SWIPER DOCENTES
  ==================================*/
  document.querySelectorAll('.du-swiper-expert .swiper').forEach(sw => {
    new Swiper(sw, {
      slidesPerView: 1,
      spaceBetween: 20,
      navigation: {
        nextEl: sw.querySelector('.swiper-button-next'),
        prevEl: sw.querySelector('.swiper-button-prev'),
      },
      pagination: {
        el: sw.querySelector('.swiper-pagination'),
        clickable: true
      },
      breakpoints: {
        1024: {
          slidesPerView: 4,
          spaceBetween: 30
        }
      }
    });
  });

});
</script>
