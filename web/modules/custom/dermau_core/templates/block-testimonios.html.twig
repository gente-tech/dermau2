{% set slides_per_view = slides_per_view|default(2) %}
{% set content_alignment = content_alignment|default('full') %}

<section class="du-testimonials du-testimonials--{{ content_alignment }}">
	<div class="du-testimonials__container">

		<h2 class="du-testimonials__title">
			{{ titulo_parte_1 }}
			<span class="du-testimonials__title--highlight">
				{{ titulo_parte_2 }}
			</span>
		</h2>
    {% if slides_per_view == 1 %}
      <div class="du-testimonials__slider-wrapper_{{ slides_per_view }}">
    {% endif %}
    {% if slides_per_view == 2 %}
      <div class="du-testimonials__slider-wrapper_{{ slides_per_view }}">
    {% endif %}
			<div id="testimonial-swiper-{{ loop.index0|default(0) }}-{{ random() }}" class="swiper du-testimonials__swiper" data-slides-per-view="{{ slides_per_view }}" data-content-alignment="{{ content_alignment }}">
				<div class="swiper-wrapper">

					{% for item in items %}
						<div class="swiper-slide">
							<article class="du-card__testimonial">

								<div class="du-card__testimonial-image-box">
									<img src="{{ item.foto }}" alt="{{ item.nombre }}" class="du-card__testimonial-img"/>
								</div>

								<div class="du-card__testimonial-content">
									<span class="du-card__testimonial-quote du-card__testimonial-quote--open">“</span>

									<p class="du-card__testimonial-text">
										{{ item.testimonio }}
									</p>

									<span class="du-card__testimonial-quote du-card__testimonial-quote--close">”</span>

									<div class="du-card__testimonial-author">
										<h4 class="du-card__testimonial-name">
											{{ item.nombre }}
										</h4>
										<p class="du-card__testimonial-role">
											{{ item.cargo }}
										</p>
									</div>

								</div>
							</article>
						</div>
					{% endfor %}

				</div>
			</div>

			<div class="swiper-button-prev du-testimonials__prev"></div>
			<div class="swiper-button-next du-testimonials__next"></div>
			<div class="swiper-pagination du-testimonials__pagination"></div>
		</div>

		{% if texto_boton is not empty %}
			<div class="du-testimonials__actions">
				<a href="{{ url_boton }}" class="du-btn du-btn--secundary-dark">
					{{ texto_boton }}
					{% if texto_boton_highlight is not empty %}
						<span class="du-btn__link">{{ texto_boton_highlight }}</span>
					{% endif %}
				</a>
			</div>
		{% endif %}

	</div>
</section>
