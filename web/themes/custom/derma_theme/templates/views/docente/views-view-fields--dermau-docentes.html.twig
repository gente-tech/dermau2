{% set nombre_docente = fields.title is defined ? fields.title.content|striptags|trim : row._entity.label() %}
{% set especialidad_label = fields.field_especialidad is defined ? fields.field_especialidad.content|striptags|trim : '' %}
{% set universidad_label = fields.field_universidad_principal is defined ? fields.field_universidad_principal.content|striptags|trim : '' %}
{% set perfil = fields.field_perfil_profesional is defined ? fields.field_perfil_profesional.content|striptags|trim : '' %}
{% set docente_url = path('entity.node.canonical', {'node': row._entity.id()}) %}

<div class="du-programs-item">
  <article class="du-card__diplomat du-card-docente">
    <div class="du-card__diplomat-content">
      <div class="du-card-docente__top">
        <div class="du-card-docente__image-wrap du-card__diplomat-image-container">
          {% if row._entity.field_foto.entity %}
            <img src="{{ file_url(row._entity.field_foto.entity.uri.value) }}" alt="{{ nombre_docente }}" class="du-card__diplomat-image">
          {% endif %}
        </div>

        <div class="du-card-docente__heading">
          <h3 class="du-card__diplomat-title">{{ fields.title.content }}</h3>
          {% if especialidad_label != '' %}
            <p class="du-card__diplomat-description">{{ fields.field_especialidad.content }}</p>
          {% endif %}
        </div>
      </div>

      <div class="du-card__diplomat-info du-card-docente__info-list">
        {% if universidad_label != '' %}
          <div class="du-card__diplomat-info-item">
            <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 1.99457C7.5 1.99457 4 -1.00543 0.5 1.49457V12.4946C4 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457C7.5 1.99457 11 -1.00543 14.5 1.49457V12.4946C11 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457V12.4946" stroke="#007BE3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="du-card__diplomat-info-text">{{ fields.field_universidad_principal.content }}</span>
          </div>
        {% endif %}

        <div class="du-card__diplomat-info-item du-card-docente__programs-title">
          <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 1.99457C7.5 1.99457 4 -1.00543 0.5 1.49457V12.4946C4 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457C7.5 1.99457 11 -1.00543 14.5 1.49457V12.4946C11 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457V12.4946" stroke="#007BE3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="du-card__diplomat-info-text">Programas:</span>
        </div>
      </div>

      {% if perfil != '' %}
        <p class="du-card__diplomat-description du-card-docente__bio">{{ fields.field_perfil_profesional.content }}</p>
      {% endif %}

      <a href="{{ docente_url }}" class="du-card__diplomat-btn">Ver detalle</a>
    </div>
  </article>
</div>
