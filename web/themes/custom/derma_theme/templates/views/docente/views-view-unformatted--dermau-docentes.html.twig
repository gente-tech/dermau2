{% for row in rows %}
	{% set docente = row.content['#row']._entity %}
	{% set programas = docente.field_docentes %}

	<div class="docente-item">
		<h3>{{ docente.label }}</h3>

		<div>
			<strong>Programas:</strong>
			{% for programa in programas %}
				{{ programa.entity.label }}
				{% if not loop.last %},
				{% endif %}
			{% endfor %}
		</div>
	</div>
{% endfor %}
