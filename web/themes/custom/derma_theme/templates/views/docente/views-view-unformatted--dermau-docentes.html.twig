{% for row in rows %}
  {% set docente = row.docente_entity %}
  {% set programas = row.programas_relacionados %}

  <div class="du-docente-card">

    <h3 class="du-docente-card__name">
      {{ docente.label }}
    </h3>

	{% if not docente.field_especialidad.isEmpty %}
		<div class="du-docente-card__especialidad">
			{{ docente.field_especialidad.entity.label }}
		</div>	
	{% endif %}

    {% if programas %}
      <div class="du-docente-card__programas">
        {% for programa in programas %}
          
          <a href="{{ programa.url }}" class="du-docente-card__programa">
            
            <span 
              class="du-docente-card__programa-tag"
              style="background-color: {{ programa.tipo_programa_color }}"
            >
              {{ programa.tipo_programa }}
            </span>

            {{ programa.title }}

          </a>

        {% endfor %}
      </div>
    {% endif %}

	{% if not docente.field_perfil_profesional.isEmpty %}
      <div class="du-docente-card__perfil">
        {{ docente.field_perfil_profesional.value }}
      </div>
    {% endif %}

    <div class="du-docente-card__link">
      <a href="{{ row.docente_url }}">{{ docente.label }}</a>
    </div>

  </div>
{% endfor %}