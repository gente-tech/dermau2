{% set hay_filtros = false %}

{% set universidad = view.exposed_raw_input.field_universidad_principal_target_id|default('') %}
{% set tipo_programa_docente = view.exposed_raw_input.tipo_programa_docente|default('') %}
{% set title_filter = view.exposed_raw_input.title|default('') %}

{% if title_filter|trim != '' %}
  {% set hay_filtros = true %}
{% endif %}

{% if universidad != '' and universidad != 'All' %}
  {% set hay_filtros = true %}
{% endif %}

{% if tipo_programa_docente != '' and tipo_programa_docente != 'All' %}
  {% set hay_filtros = true %}
{% endif %}

<section class="du-generic-swiper du-swiper-program">
  <div class="du-generic-swiper__container du-swiper-oferta__container">
    <div class="du-generic-swiper__header">
      {% if hay_filtros %}
        <h3>Mostrando <span>{{ view.total_rows }} {{ view.total_rows == 1 ? 'docente' : 'docentes' }}</span></h3>
      {% else %}
        <h3>Docentes <span>Recomendados</span></h3>
      {% endif %}
    </div>

    {% if rows %}
      <div class="du-programs-container">
        {% for row in rows %}
          {% set docente = row.docente_entity ?? null %}
          {% set programas = row.programas_relacionados ?? [] %}
          {% set docente_url = row.docente_url ?? (docente ? path('entity.node.canonical', {'node': docente.id()}) : '#') %}
          {% set card_class = hay_filtros ? 'du-programs-grid__item' : 'du-programs-item' %}
          {% set nombre_docente = docente ? docente.label() : '' %}
          {% set especialidad = docente and docente.field_especialidad is defined and not docente.field_especialidad.isEmpty ? docente.field_especialidad.entity.label() : '' %}
          {% set universidad_label = docente and docente.field_universidad_principal is defined and not docente.field_universidad_principal.isEmpty ? docente.field_universidad_principal.entity.label() : '' %}
          {% set perfil = docente and docente.field_perfil_profesional is defined and not docente.field_perfil_profesional.isEmpty ? docente.field_perfil_profesional.value : '' %}

          <div class="{{ card_class }}">
            <article class="du-card__diplomat">
              <div class="du-card__diplomat-content">
                <div class="du-card-docente__top">
                  <div class="du-card-docente__image-wrap">
                    {% if docente and docente.field_foto is defined and not docente.field_foto.isEmpty and docente.field_foto.entity %}
                      <img src="{{ file_url(docente.field_foto.entity.uri.value) }}" alt="{{ nombre_docente }}" class="du-card__diplomat-image">
                    {% endif %}
                  </div>

                  <div class="du-card-docente__heading">
                    <h3 class="du-card__diplomat-title">{{ nombre_docente }}</h3>
                    {% if especialidad != '' %}
                      <p class="du-card__diplomat-description">{{ especialidad }}</p>
                    {% endif %}
                  </div>
                </div>

                <div class="du-card__diplomat-info du-card-docente__info-list">
                  {% if universidad_label != '' %}
                    <div class="du-card__diplomat-info-item">
                      <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 1.99457C7.5 1.99457 4 -1.00543 0.5 1.49457V12.4946C4 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457C7.5 1.99457 11 -1.00543 14.5 1.49457V12.4946C11 9.99457 7.5 12.4946 7.5 12.4946M7.5 1.99457V12.4946" stroke="#007BE3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span class="du-card__diplomat-info-text">{{ universidad_label }}</span>
                    </div>
                  {% endif %}

                  {% if programas is not empty %}
                    <div class="du-card__diplomat-info-item du-card-docente__programs-title">
                      <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 1.5H13C13.2761 1.5 13.5 1.72386 13.5 2V11C13.5 11.2761 13.2761 11.5 13 11.5H2C1.72386 11.5 1.5 11.2761 1.5 11V2C1.5 1.72386 1.72386 1.5 2 1.5Z" stroke="#007BE3"/>
                        <path d="M4.5 1.5V11.5" stroke="#007BE3"/>
                      </svg>
                      <span class="du-card__diplomat-info-text">Programas:</span>
                    </div>

                    <div class="du-card-docente__programs">
                      {% for programa in programas %}
                        <span class="du-card__diplomat-badge tag"{% if programa.tipo_programa_color is not empty %} data-tag="{{ programa.tipo_programa_color }}"{% endif %}>{{ programa.title }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                {% if perfil != '' %}
                  <p class="du-card__diplomat-description du-card-docente__bio">{{ perfil }}</p>
                {% endif %}

                <a href="{{ docente_url }}" class="du-card__diplomat-btn">Ver detalle</a>
              </div>
            </article>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="du-generic-swiper__header">
        <h3 class="du-programs-message">Ups, no hay resultados <span>por ahora.</span></h3>
      </div>
    {% endif %}
  </div>
</section>
